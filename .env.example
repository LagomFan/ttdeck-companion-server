# TTDeck Companion Server example environment.
# Copy to .env locally. Never commit real .env files.

BIND_HOST=0.0.0.0
PORT=4020
PUBLIC_BASE_URL=http://localhost:4020

DATA_SOURCE_MODE=fixture

# Generate unique values locally, for example:
#   openssl rand -hex 32
TOKEN_SECRET=<generated-long-random-secret>
SETUP_SECRET=<generated-setup-secret>
TOKEN_STORE_PATH=/data/read-tokens.json
DEVICE_SECRET_REQUIRED=true

# TeslaMate Postgres. Prefer a dedicated read-only database user.
TESLAMATE_DB_HOST=database
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=teslamate_readonly
TESLAMATE_DB_PASSWORD=<readonly-password>
TESLAMATE_DB_SSL=false
TESLAMATE_DB_QUERY_TIMEOUT_MS=5000

# Optional TeslaMate MQTT realtime data.
MQTT_ENABLED=false
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=teslamate/cars

# Optional notifications. Native APNs is an advanced custom-build path.
PUSH_NOTIFICATIONS_ENABLED=false
NOTIFICATION_STATE_STORE_PATH=/data/notification-state.json
NOTIFICATION_POLL_INTERVAL_MS=45000
POST_TRIP_WATCH_MINUTES=15
APNS_ENABLED=false
APNS_ENVIRONMENT=development
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.example.ttdeck
APNS_PRIVATE_KEY_PATH=
